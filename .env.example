# Copy this file to .env for local development, then replace the value below.
# Generate a key with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-long-random-local-secret

# Local HTTP development must keep this false. Set it to true in HTTPS hosting.
COOKIE_SECURE=false

# Optional: Flask defaults to instance/inventory.db when this is not set.
# DATABASE_URI=sqlite:///inventory.db
